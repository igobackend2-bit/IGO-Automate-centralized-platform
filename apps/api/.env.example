# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# --- Supabase (existing project - do NOT create a new one) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- WhatsApp provider selection: wati | evolution ---
WHATSAPP_PROVIDER=wati

# WATI (current, kept live until Phase 3/5 cutover)
WATI_API_ENDPOINT=
WATI_API_TOKEN=

# Evolution API (new, official WhatsApp Cloud API mode)
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# --- Email (listmonk) ---
LISTMONK_BASE_URL=
LISTMONK_API_USERNAME=
LISTMONK_API_TOKEN=

# --- n8n ---
N8N_BASE_URL=
N8N_WEBHOOK_TOKEN=

# --- AI provider selection: groq | gemini | ollama ---
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1-igo-finetuned

# --- Webhook shared secrets (verify inbound provider webhooks) ---
WATI_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_SECRET=
LISTMONK_WEBHOOK_SECRET=
