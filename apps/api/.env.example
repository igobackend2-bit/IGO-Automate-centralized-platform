# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# --- Supabase (project: hoeumzjuthbnhlpelbkn, "automation platform own") ---
SUPABASE_URL=https://hoeumzjuthbnhlpelbkn.supabase.co
# secret — get from Supabase dashboard: Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
# not secret, but left blank here anyway — copy the real value into your local .env
SUPABASE_ANON_KEY=

# --- WhatsApp provider selection: wati | evolution ---
WHATSAPP_PROVIDER=wati

# WATI (current, kept live until Phase 3/5 cutover)
# Base host is https://live-mt-server.wati.io unless WATI moves your account
# to a different data-center — only set WATI_API_BASE_URL to override that.
WATI_API_BASE_URL=
WATI_TENANT_ID=
WATI_API_TOKEN=
WATI_CHANNEL_NUMBER=

# Evolution API (new, official WhatsApp Cloud API mode)
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# --- Email (listmonk) ---
LISTMONK_BASE_URL=
LISTMONK_API_USERNAME=
LISTMONK_API_TOKEN=

# --- n8n ---
N8N_BASE_URL=
N8N_WEBHOOK_TOKEN=

# --- AI provider selection: groq | gemini | ollama ---
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1-igo-finetuned

# --- Webhook shared secrets (verify inbound provider webhooks) ---
WATI_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_SECRET=
LISTMONK_WEBHOOK_SECRET=
