# Root env for docker-compose. Copy to `.env`, fill in real values, never commit.
# Verify exact env var names against each project's CURRENT docs before a real
# deploy — Evolution API and listmonk both change these between releases.

# --- shared infra postgres (serves listmonk + evolution-api only;
#     the platform's own data lives in the existing Supabase project) ---
INFRA_POSTGRES_USER=igo_infra
INFRA_POSTGRES_PASSWORD=change-me
POSTGRES_MULTIPLE_DATABASES=listmonk,evolution

# --- Evolution API (WhatsApp, official Cloud API mode) ---
EVOLUTION_API_KEY=change-me
EVOLUTION_SERVER_URL=https://wa-api.igogroups.com
# WhatsApp Cloud API credentials from Meta (per-instance, set after first deploy)
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# --- listmonk (email) ---
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=change-me
LISTMONK_PUBLIC_URL=https://mail.igogroups.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- platform app (mirrors apps/api/.env.example) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
